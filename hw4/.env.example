# Campus Customs — environment template
#
# Copy this file to `.env` in this same folder and fill in your own key.
# The real .env is gitignored and must never be committed.
#
#   cp .env.example .env

# Required. Your Portkey gateway key, used for all model calls.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional. The model the agent uses. Defaults to gpt-5.6-luna when unset.
# Point this at a larger model if you want a stronger agent.
# CAMPUS_CUSTOMS_MODEL=gpt-5.6-luna

# Optional. Seconds to cache the read-only catalogue in memory. Defaults to 300.
# CAMPUS_CUSTOMS_CACHE_TTL=300
